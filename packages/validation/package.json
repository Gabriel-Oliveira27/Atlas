{
  "name": "@atlas/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas Zod compartilhados — a mesma validação roda na API e nos formulários do front-end",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
