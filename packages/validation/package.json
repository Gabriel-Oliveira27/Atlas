    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist"
  ]
}
