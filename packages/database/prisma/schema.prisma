// ============================================================================
// ATLAS — Schema do banco de dados
//
// Um único schema serve aos DOIS bancos:
//   • PostgreSQL local (Docker, porta 5433) — PRINCIPAL
//   • Neon PostgreSQL (nuvem)               — SECUNDÁRIO / failover / backup
//
// O `datasource` abaixo aponta para o banco local. O cliente da nuvem é
// criado em runtime com `new PrismaClient({ datasources: { db: { url } } })`
// — ver `src/client.ts`. Manter um schema só é o que garante que a
// reconciliação entre os dois bancos compare estruturas idênticas.
//
// ─── PADRÃO DE SINCRONIZAÇÃO ────────────────────────────────────────────────
// Todo modelo sincronizável carrega:
//   version     Int       — incrementa a cada escrita; base do Last-Write-Wins
//   createdAt   DateTime
//   updatedAt   DateTime
//   deletedAt   DateTime? — exclusão é LÓGICA (tombstone). Apagar de verdade
//                           impediria propagar a remoção para o outro nó.
//   originNode  String    — qual nó escreveu; evita que a alteração volte
//                           para quem a originou (eco infinito).
//
// Detalhes em `docs/offline-sync.md`.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL_LOCAL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [unaccent, pg_trgm, pgcrypto]
}

