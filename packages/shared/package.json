{
  "name": "@atlas/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos, enums de domínio, erros, constantes e utilitários compartilhados entre API, web e mobile",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
