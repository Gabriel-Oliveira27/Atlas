# Prisma e alguns pacotes nativos precisam rodar scripts de pós-instalação.
# O pnpm 9 bloqueia isso por padrão; liberamos apenas o necessário.
enable-pre-post-scripts=true
auto-install-peers=true
strict-peer-dependencies=false
# Mantém o isolamento de módulos do pnpm (sem hoisting fantasma),
# exceto para ferramentas que exigem resolução na raiz.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=prisma
