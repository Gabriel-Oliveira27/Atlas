#############################################
# Atlas — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
#############################################

NODE_ENV=development
TZ=America/Sao_Paulo

# ─────────────────────────────────────────
# Identidade do nó (usado na sincronização)
# Cada instância da API deve ter um ID único.
# É gravado em ChangeLog.originNode para evitar
# que uma alteração volte para quem a originou.
# ─────────────────────────────────────────
NODE_ID=local-dev-01

# ─────────────────────────────────────────
# Banco LOCAL (Postgres no Docker) — PRINCIPAL
# Porta 5433 no host para não conflitar com um
# PostgreSQL já instalado no Windows (5432).
# ─────────────────────────────────────────
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL_LOCAL="postgresql://atlas:atlas_dev_password@localhost:5433/atlas?schema=public&connection_limit=10"

# ─────────────────────────────────────────
# Banco NUVEM (Neon) — SECUNDÁRIO / failover
# Pegue em https://console.neon.tech → Connection string (Pooled).
# Mantenha `sslmode=require`.
# ─────────────────────────────────────────
DATABASE_URL_CLOUD="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/atlas?sslmode=require"

# Qual banco tem prioridade: LOCAL | CLOUD
# A especificação exige LOCAL sempre que estiver acessível.
DATABASE_PRIMARY=LOCAL
# Intervalo (ms) do health-check do banco local
DATABASE_HEALTHCHECK_INTERVAL_MS=15000
# Timeout (ms) para considerar o banco local indisponível
DATABASE_HEALTHCHECK_TIMEOUT_MS=3000

# ─────────────────────────────────────────
# Redis (filas BullMQ + rate limit)
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=atlas

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_PORT=3333
API_HOST=0.0.0.0
API_PREFIX=api
API_PUBLIC_URL=http://localhost:3333

# API_HOST=0.0.0.0 já a deixa acessível pela rede local — é o que permite
# o celular alcançá-la. No Windows, a primeira execução costuma abrir o
# aviso do firewall: é preciso liberar, senão o celular recebe timeout.

# Origens permitidas (CORS), separadas por vírgula.
#
# Aceita curinga em UM rótulo do host:
#   https://*.vercel.app        → deploys de preview, que ganham domínio
#                                 novo a cada branch
#   https://*.trycloudflare.com → o túnel (`pnpm api:expose`), cujo
#                                 subdomínio é sorteado a cada execução
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:19006,https://*.vercel.app,https://*.trycloudflare.com

# Libera origens da rede local (192.168.x, 10.x, 172.16-31.x, localhost).
# Permite abrir o web pelo celular no mesmo Wi-Fi sem cadastrar o IP, que
# muda quando o roteador renova o DHCP.
#
# Sem valor: ligado fora de produção, desligado em produção. Mantenha
# DESLIGADO em produção — num servidor, uma origem "privada" não é o seu
# notebook, é outra máquina do datacenter.
CORS_ALLOW_LAN=true

# ─────────────────────────────────────────
# JWT / Autenticação
# Gere segredos fortes:  openssl rand -base64 48
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_REFRESH_TTL=30d
JWT_ISSUER=atlas
JWT_AUDIENCE=atlas-clients

# ─────────────────────────────────────────
# Google OAuth
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URIs autorizados:
#   http://localhost:3333/api/auth/google/callback
#   https://api.atlas.vercel.app/api/auth/google/callback
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback
# Para onde o usuário é devolvido depois do login
OAUTH_SUCCESS_REDIRECT_WEB=http://localhost:3000/auth/callback
OAUTH_SUCCESS_REDIRECT_MOBILE=atlasapp://auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:3000/auth/error

# ─────────────────────────────────────────
# Cloudinary (mídias: fotos, GIFs, vídeos)
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=atlas

# ─────────────────────────────────────────
# N8N
# ─────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
# Segredo compartilhado: a API assina os webhooks enviados ao n8n
# e valida os webhooks recebidos dele (header x-atlas-signature).
N8N_WEBHOOK_SECRET=troque-este-segredo-de-webhook
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=atlas_n8n_password

# ─────────────────────────────────────────
# Camada de IA (todas opcionais — habilite a que for usar)
# ─────────────────────────────────────────
AI_PROVIDER=claude
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=60000

# ─────────────────────────────────────────
# Sincronização
# Cron no fuso America/Sao_Paulo: 03:00 e 18:00
# ─────────────────────────────────────────
SYNC_ENABLED=true
SYNC_CRON_MORNING=0 3 * * *
SYNC_CRON_EVENING=0 18 * * *
SYNC_BATCH_SIZE=500
SYNC_MAX_RETRIES=5
SYNC_RETRY_BACKOFF_MS=5000

# ─────────────────────────────────────────
# Rate limit
#
# O padrão vale para leituras. As famílias abaixo cobrem rotas cujo
# custo é diferente e só se aplicam onde a rota declara @ThrottleFamily.
# O contador fica no Redis: o limite é do sistema, não do processo.
# ─────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Autenticação — alvo de força bruta
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_TTL_MS=60000

# Sincronização — cargas grandes, custo alto por requisição
RATE_LIMIT_SYNC_MAX=10
RATE_LIMIT_SYNC_TTL_MS=60000

# IA — cada chamada custa dinheiro real ao provedor (5 por HORA)
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_TTL_MS=3600000

# ─────────────────────────────────────────
# Seed
#
# O administrador criado pelo seed nasce SEM senha: o seed imprime um
# código de ativação e a senha é criada no primeiro acesso pela tela.
# ─────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@atlas.local
SEED_ADMIN_CPF=02515718310

# ─────────────────────────────────────────
# Observabilidade
# ─────────────────────────────────────────
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Front-end (web / mobile)
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3333/api
