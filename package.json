{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas — plataforma de gerenciamento de treinos, evolução física e hidratação",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env logs -f",
    "docker:reset": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env down -v",
    "db:generate": "pnpm --filter @atlas/database generate",
    "db:migrate": "pnpm --filter @atlas/database migrate:local",
    "db:migrate:cloud": "pnpm --filter @atlas/database migrate:cloud",
    "db:migrate:both": "node infra/scripts/migrate-both.mjs",
    "db:seed": "pnpm --filter @atlas/database seed",
    "db:studio": "pnpm --filter @atlas/database studio",
    "api:dev": "pnpm --filter @atlas/api dev",
    "bootstrap": "node infra/scripts/bootstrap.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@atlas/config": "workspace:*",
    "@types/node": "^22.9.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
