#############################################
# Atlas — variáveis do docker compose
# Copie para `infra/docker/.env`.
# Os valores devem bater com o `.env` da raiz.
#############################################

TZ=America/Sao_Paulo

# Postgres (banco principal)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
# 5433 no host evita conflito com um PostgreSQL já instalado no Windows
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=atlas_n8n_password
N8N_ENCRYPTION_KEY=atlas-n8n-encryption-key-change-me
N8N_LOG_LEVEL=info
N8N_WEBHOOK_SECRET=troque-este-segredo-de-webhook
# Como os workflows do n8n alcançam a API rodando no host
ATLAS_API_URL=http://host.docker.internal:3333/api

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@atlas.local
PGADMIN_PASSWORD=atlas_pgadmin_password

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas_minio_password
